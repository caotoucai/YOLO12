<Window x:Class="IndustrialVision.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Industrial Vision · YOLO12 产品与缺陷检测" Width="1440" Height="920" MinWidth="1100" MinHeight="720" Background="#F1F5F9" Closing="OnClosing">
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="160"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,14"><TextBlock Text="INDUSTRIAL VISION  /  产品 · 缺陷 · 标注" FontSize="23" FontWeight="Bold" Foreground="#0F172A"/><TextBlock x:Name="Status" Text="就绪 · 先选择图片和模型" HorizontalAlignment="Right" Margin="25,0,0,0"/></DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="305"/><ColumnDefinition Width="*"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
   <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0"><StackPanel x:Name="Settings">
    <TextBlock Text="单图物品检测（默认预设）" FontSize="17" FontWeight="Bold"/>
    <TextBlock Text="打开图片 → 点击产品检测，查看物品名称和位置。" TextWrapping="Wrap" Foreground="#64748B" Margin="0,5"/>
    <Button Content="恢复单图检测默认设置" Click="ApplyDetectionPreset" Margin="0,0,0,8"/>
    <TextBlock Text="运行环境" FontSize="17" FontWeight="Bold"/>
    <TextBlock Text="Python 可执行文件（已安装 ultralytics）"/><TextBox x:Name="PythonPath"/>
    <TextBlock Text="设备：cpu 或 GPU 编号 0"/><TextBox x:Name="Device" Text="cpu"/>
    <TextBlock Text="产品模型 / 初始训练权重"/><DockPanel><Button DockPanel.Dock="Right" Content="浏览" Click="PickProduct"/><TextBox x:Name="ProductModel" Text="yolo12n.pt"/></DockPanel>
    <TextBlock Text="缺陷模型（需训练后的权重）"/><DockPanel><Button DockPanel.Dock="Right" Content="浏览" Click="PickDefect"/><TextBox x:Name="DefectModel"/></DockPanel>
    <TextBlock Text="置信度阈值"/><TextBox x:Name="Confidence" Text="0.25"/>
    <WrapPanel><Button Content="打开图片" Click="OpenImage"/><Button x:Name="ProductDetectionButton" Content="产品检测" Click="DetectProducts"/><Button Content="缺陷检测" Click="DetectDefects"/><Button Content="联合检测" Click="Inspect"/></WrapPanel>
    <Separator Margin="0,12"/><TextBlock Text="标注与数据集" FontSize="17" FontWeight="Bold"/>
    <TextBlock Text="有序类别，英文逗号分隔（数据集创建后固定）" TextWrapping="Wrap"/><TextBox x:Name="Classes" Text="bottle" TextChanged="ClassesChanged"/>
    <ComboBox x:Name="SelectedClass" Margin="0,0,0,8"/>
    <CheckBox x:Name="AnnotationMode" Content="拖动鼠标绘制标注框" IsChecked="False" Margin="0,5"/>
    <TextBlock Text="数据集目录（产品与缺陷使用不同目录）" TextWrapping="Wrap"/><TextBox x:Name="DatasetRoot"/>
    <CheckBox x:Name="Validation" Content="保存到验证集 val（使用独立图片）" Margin="0,5"/>
    <CheckBox x:Name="Negative" Content="确认当前图片是无目标负样本" Margin="0,5"/>
    <WrapPanel><Button Content="保存标注" Click="SaveAnnotations"/><Button Content="导入标签" Click="ImportLabels"/><Button Content="删除选中框" Click="DeleteAnnotation"/><Button Content="清空标注" Click="ClearAnnotations"/></WrapPanel>
    <Separator Margin="0,12"/><TextBlock Text="训练" FontSize="17" FontWeight="Bold"/>
    <CheckBox x:Name="TrainDefect" Content="训练缺陷模型（否则训练产品模型）" Margin="0,7"/>
    <TextBlock Text="训练轮数 / 图像尺寸 / batch"/><StackPanel Orientation="Horizontal"><TextBox x:Name="Epochs" Text="100" Width="80"/><TextBox x:Name="ImageSize" Text="640" Width="85"/><TextBox x:Name="Batch" Text="4" Width="80"/></StackPanel>
    <TextBlock Text="初始权重使用上方产品模型；训练完成自动更新目标模型路径。" TextWrapping="Wrap" Foreground="#64748B"/>
    <WrapPanel><Button Content="启动训练" Click="Train"/><Button Content="导出 ONNX" Click="ExportOnnx"/></WrapPanel>
   </StackPanel></ScrollViewer>
   <Border Grid.Column="1" Background="#0F172A" CornerRadius="8" ClipToBounds="True" Margin="0,0,12,0">
    <Grid><TextBlock Text="打开一张产品图片开始检测或框选标注" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     <Viewbox Stretch="Uniform"><Grid x:Name="ImageSurface" Background="Transparent"><Image x:Name="Photo" Stretch="Fill"/><Canvas x:Name="Overlay" Background="Transparent" MouseLeftButtonDown="BeginBox" MouseMove="MoveBox" MouseLeftButtonUp="EndBox"/></Grid></Viewbox>
    </Grid>
   </Border>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="检测结果 · 原图像素坐标" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
    <ListBox Grid.Row="1" x:Name="Results" FontFamily="Consolas" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
    <TextBlock Grid.Row="2" Text="人工标注（选择后可删除）" FontSize="16" FontWeight="Bold" Margin="0,16,0,8"/>
    <ListBox Grid.Row="3" x:Name="Annotations" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
    <Button Grid.Row="4" Content="导出检测结果 JSON" Click="ExportResults"/>
   </Grid>
  </Grid>
  <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBox x:Name="Logs" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Background="#E2E8F0"/><Button Grid.Column="1" Content="停止任务" Click="Cancel" VerticalAlignment="Top"/></Grid>
 </Grid>
</Window>
